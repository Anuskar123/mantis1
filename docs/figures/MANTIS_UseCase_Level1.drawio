        <mxCell id="ext1" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;br&gt;[threat detected]" style="endArrow=open;endSize=12;dashed=1;html=1;strokeWidth=1;strokeColor=#000000;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="uc5" target="uc2">
