        </mxCell>

        <!-- Block Malicious extends Respond to Detected [active defence enabled] -->
        <mxCell id="ext2" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;br&gt;[active defence enabled]" style="endArrow=open;endSize=12;dashed=1;html=1;strokeWidth=1;strokeColor=#000000;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="uc8" target="uc5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Forward Alert extends Generate Security Alert [SIEM forwarding enabled] -->
        <mxCell id="ext3" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;&lt;br&gt;[SIEM forwarding enabled]" style="endArrow=open;endSize=12;dashed=1;html=1;strokeWidth=1;strokeColor=#000000;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="uc9" target="uc6">
