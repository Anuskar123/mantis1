        <!-- Detect Network Threats includes Capture and Analyse -->
        <mxCell id="inc2" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;strokeWidth=1;strokeColor=#000000;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="uc2" target="uc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Operate MANTIS includes Configure Detection -->
        <mxCell id="inc3" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="endArrow=open;endSize=12;dashed=1;html=1;strokeWidth=1;strokeColor=#000000;labelBackgroundColor=#FFFFFF;fontSize=10;" edge="1" parent="1" source="uc1" target="uc4">
          <mxGeometry relative="1" as="geometry" />
