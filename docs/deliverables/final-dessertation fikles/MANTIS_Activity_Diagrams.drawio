        <mxCell id="a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;arcSize=20;" value="pacman -S iptables&#xa;[Arch / Manjaro]" vertex="1">
          <mxGeometry height="55" width="220" x="700" y="595" as="geometry" />
