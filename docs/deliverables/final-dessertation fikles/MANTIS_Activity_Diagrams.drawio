        <!-- Decision 1: Debian -->
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;fontStyle=1;" value="Debian family&#xa;(apt)?" vertex="1">
