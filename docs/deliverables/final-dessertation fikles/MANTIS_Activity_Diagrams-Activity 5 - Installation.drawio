        </mxCell>
        <mxCell id="read" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;arcSize=20;" value="Read /etc/os-release&#xa;[detect distribution ID]" vertex="1">
          <mxGeometry height="50" width="280" x="360" y="170" as="geometry" />
        </mxCell>

        <!-- Decision 1: Debian -->
        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;fontStyle=1;" value="Debian family&#xa;(apt)?" vertex="1">
          <mxGeometry height="90" width="180" x="410" y="260" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;arcSize=20;" value="apt install iptables&#xa;[Debian / Ubuntu / Kali]" vertex="1">
          <mxGeometry height="55" width="220" x="700" y="275" as="geometry" />
        </mxCell>

        <!-- Decision 2: Fedora -->
        <mxCell id="d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;fontStyle=1;" value="Fedora / RHEL&#xa;(dnf / yum)?" vertex="1">
          <mxGeometry height="90" width="180" x="410" y="420" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;arcSize=20;" value="dnf install iptables&#xa;[Fedora / RHEL / Rocky]" vertex="1">
          <mxGeometry height="55" width="220" x="700" y="435" as="geometry" />
        </mxCell>

        <!-- Decision 3: Arch -->
        <mxCell id="d3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;fontStyle=1;" value="Arch family&#xa;(pacman)?" vertex="1">
          <mxGeometry height="90" width="180" x="410" y="580" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;arcSize=20;" value="pacman -S iptables&#xa;[Arch / Manjaro]" vertex="1">
          <mxGeometry height="55" width="220" x="700" y="595" as="geometry" />
        </mxCell>

        <!-- Decision 4: openSUSE -->
        <mxCell id="d4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;fontStyle=1;" value="openSUSE&#xa;(zypper)?" vertex="1">
          <mxGeometry height="90" width="180" x="410" y="740" as="geometry" />
