<mxfile host="app.diagrams.net">
  <diagram id="act5" name="Activity 5 - Installation">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" parent="1" style="ellipse;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="20" width="20" x="490" y="30" as="geometry" />
        </mxCell>
        <mxCell id="run" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;arcSize=20;" value="Run install.sh&#xa;[sudo bash src/install.sh]" vertex="1">
