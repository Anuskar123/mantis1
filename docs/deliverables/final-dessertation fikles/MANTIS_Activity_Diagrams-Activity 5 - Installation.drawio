        <mxCell id="unk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;arcSize=20;" value="Continue with generic&#xa;install (unknown distro)" vertex="1">
