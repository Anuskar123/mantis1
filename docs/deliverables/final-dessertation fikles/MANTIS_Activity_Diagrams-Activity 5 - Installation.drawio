        <mxCell id="a4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=11;arcSize=20;" value="zypper install iptables&#xa;[openSUSE / SLES]" vertex="1">
          <mxGeometry height="55" width="220" x="700" y="755" as="geometry" />
        </mxCell>

        <!-- Decision 5: Alpine -->
